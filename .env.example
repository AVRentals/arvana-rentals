VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Your real Supabase auth user UUID (Authentication > Users, after you create your own login)
VITE_HOST_ID=your-real-uuid-here
# Email shown in the Fleet Manager sidebar
VITE_ADMIN_EMAIL=17.mateo@gmail.com
# NOTE: there is no VITE_ADMIN_PASSWORD any more. /admin signs in against
# your real Supabase owner account (the one whose profile has is_host = true),
# because anything in a VITE_ var is compiled into the public JS bundle and
# would be readable by anyone viewing source.
